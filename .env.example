# Google Drive backup (OAuth 2.0 Web client)
# Create at https://console.cloud.google.com/apis/credentials
# Enable Google Drive API + add authorized JS origin (e.g. http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public site URL (CSRF Origin allowlist). On Vercel usually auto from request.
NEXT_PUBLIC_SITE_URL=

# Telegram Login Widget
# 1) Create a bot with @BotFather → get token
# 2) /setdomain → your production host
# 3) Put bot username without @ and the token below
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Optional shared secret for Telegram webhook header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Admin panel (/manage). Comma-separated emails that always get admin rights.
# The first registered user becomes admin automatically.
FRIENDS_ADMIN_EMAILS=

# Local-only: seed admin@friends.local (never on Vercel/production)
# FRIENDS_SEED_DEFAULT_ADMIN=1
# FRIENDS_SEED_ADMIN_PASSWORD=

# Email login codes (Resend). Without RESEND_API_KEY, codes are logged in development only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Friends <onboarding@resend.dev>

# Required in production / Vercel — signs session cookies and OTP HMAC
FRIENDS_SESSION_SECRET=

# AI agents (news + support) via Vercel AI Gateway
AI_GATEWAY_API_KEY=
FRIENDS_AI_MODEL=openai/gpt-4o-mini
CRON_SECRET=
